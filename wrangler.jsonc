{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare Workers + Static Assets. `astro build` (@astrojs/cloudflare 14) writes the deployable
  // config to dist/server/wrangler.json (assets.directory "../client"); scripts/check-worker-config.mjs
  // gates it. public/_headers (immutable /_astro/*, AASA content type) is applied by Static Assets.
  "name": "smol-fe",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "smol.xyz", "custom_domain": true }],
  "assets": { "binding": "ASSETS" },
  // Build-time PUBLIC_* defaults (astro.config.mjs copies them onto process.env when unset, so
  // process.env / .env overrides win). They are inlined into the client and SSR bundles.
  "vars": {
    "PUBLIC_API_URL": "https://api.smol.xyz",
    "PUBLIC_CHAIN_SNAPSHOT": "1",
    "PUBLIC_KALE_SAC_ID": "CB23WRDQWGSP6YPMY4UV5C4OW5CBTXKYN3XEATG7KJEZCXMJBYEHOUOV",
    "PUBLIC_MINT_STATUS": "1",
    "PUBLIC_NETWORK_PASSPHRASE": "Public Global Stellar Network ; September 2015",
    "PUBLIC_RELAYER_URL": "https://api.kalefarm.xyz",
    "PUBLIC_RPC_URL": "https://rpc.lightsail.network/",
    "PUBLIC_SMOL_CONTRACT_ID": "CBRNUVLGFM5OYWAGZVGU7CTMP2UJLKZCLFY2ANUCK5UGKND6BBAA5PLA",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAABBPiK_8QHc6n8E4",
    "PUBLIC_WALLET_WASM_HASH": "e45c42b944a767bd5f37f8c4a469b48917d28e23481dbfd550419c84cdacde92"
  },
  "services": [{ "binding": "SMOL_API", "service": "smol-workflow" }]
}
