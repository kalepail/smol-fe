{
  "name": "smol-fe",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "astro sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:worker": "node scripts/check-worker-config.mjs",
    "test:e2e": "playwright test",
    "test:e2e:worker": "playwright test -c playwright.worker.config.ts",
    "test:unit": "node --test tests/unit/"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.5",
    "@stellar/stellar-sdk": "^14.4.3",
    "buffer": "^6.0.3",
    "comet-sdk": "link:./ext/comet-sdk",
    "passkey-kit": "^0.12.0",
    "smol-sdk": "link:./ext/smol-sdk"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/svelte": "^9.1.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "astro": "^7.4.13",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-mkcert": "^2.1.0",
    "wrangler": "^4.167.0"
  },
  "pnpm": {
