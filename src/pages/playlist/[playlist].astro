---
import Home from '../../components/Home.svelte';
import Leaderboard from '../../components/Leaderboard.svelte';
import Layout from '../../layouts/Layout.astro';
import { serverApiFetch } from '../../services/api/ssr';
import type { SmolListResponse } from '../../types/api';

const { playlist = '' } = Astro.params;
const initialData = playlist
  ? await serverApiFetch<SmolListResponse>(Astro, `/playlist/${encodeURIComponent(playlist)}?limit=100`)
  : null;
---

<Layout title={playlist || 'Playlist'}>
  <Leaderboard {playlist} {initialData} client:only="svelte" />
  <Home {playlist} endpoint={`playlist/${encodeURIComponent(playlist)}`} {initialData} client:only="svelte" />
</Layout>
