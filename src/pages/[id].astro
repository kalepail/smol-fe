---
import Smol from '../components/Smol.svelte';
import StateFeedback from '../components/ui/StateFeedback.svelte';
import Layout from '../layouts/Layout.astro';
import { serverApiFetchResult } from '../services/api/ssr';
import type { SmolDetailResponse } from '../types/domain';
import { isIndexableSong } from '../utils/robots';
import { songSafety } from '../utils/songSafety';

const { id } = Astro.params;
// F6: song ids are 64-hex; anything else (`/quota`, `/leaderboard`, typos) is a 404 without
// an API call. E2E fixtures use readable ids, so the dev seam build allows those while still
// rejecting non-song paths like `/quota`.
const isSongId = Boolean(
  id &&
    (/^[0-9a-f]{64}$/i.test(id) ||
      (import.meta.env.PUBLIC_E2E_SEAMS === '1' && /^(?:smol-|first-smol$|legacy-|does-not-exist-)/i.test(id)))
);
const result = isSongId
  ? await serverApiFetchResult<SmolDetailResponse>(Astro, `/${encodeURIComponent(id!)}`, { forwardAuth: true })
  : { status: 404, data: null };
// An authoritative 404 (or rejected id) renders the not-found view directly without
// mounting the song island; an unreachable API (0 / 5xx) lets the island retry.
const isNotFound = result.status === 404;
if (isNotFound) Astro.response.status = 404;
const initialData = result.status === 200 ? result.data : null;
const apiUrl = import.meta.env.PUBLIC_API_URL;
const title = initialData?.kv_do?.lyrics?.title || initialData?.d1?.Title || (isNotFound ? 'Song not found' : 'Song');
// Short constant satisfies WhatsApp's non-empty og:description rule without leaking prompts or lyrics.
const description = isNotFound ? 'This song could not be found.' : 'Listen on SMOL';
const isPublished = Boolean(initialData?.d1);
const isRestricted = songSafety(initialData?.kv_do?.nsfw).restricted;
// Shared preview metadata requires an authoritative 200 published, unrestricted song.
const shareable = Boolean(id && result.status === 200 && isPublished && !isRestricted);
const image_url = shareable ? `${apiUrl}/image/${id}.png` : null;
const musicId = initialData?.d1?.Song_1;
const firstReady = initialData?.kv_do?.songs?.[0];
const resolvedMusicId = musicId || (firstReady && firstReady.status >= 4 && firstReady.music_id ? firstReady.music_id : null);
const playable = Boolean(shareable && resolvedMusicId);
const song_url = playable ? `${apiUrl}/song/${encodeURIComponent(resolvedMusicId!)}.mp3` : null;
const video_eligible = Boolean(
  playable && initialData?.video_eligible === true && import.meta.env.PUBLIC_DISABLE_OG_VIDEO !== '1'
);
const videoPath =
  typeof initialData?.video_path === 'string' && initialData.video_path.startsWith('/video/')
    ? initialData.video_path
    : `/video/v2/${id}/${encodeURIComponent(resolvedMusicId!)}.mp4`;
const video_url = video_eligible ? `${apiUrl}${videoPath}` : null;
const siteOrigin = Astro.url.origin;
const oembed_url = playable
  ? `${siteOrigin}/oembed?url=${encodeURIComponent(`${siteOrigin}/${id}`)}`
  : null;
// Serve X Player Card (480x480 iframe -> /embed/[id]) exclusively to genuine X/Twitter crawlers
// (`Twitterbot/1.0`), NOT Telegram (`TelegramBot (like TwitterBot)`) or iMessage (`... Facebot Twitterbot/1.0`).
Astro.response.headers.append('Vary', 'User-Agent');
const isTwitterbot = /^Twitterbot\//i.test(Astro.request.headers.get('user-agent') || '');
const twitter_player_url =
  playable && isTwitterbot && import.meta.env.PUBLIC_DISABLE_X_PLAYER !== '1'
    ? `${siteOrigin}/embed/${id}`
    : null;
// AE-3: private (Public === 0), restricted (flagged) or unpublished songs are
// never indexed — not even on smol.xyz, where an owner's or a shared link's
// SSR would otherwise emit `index, follow`.
const noindex = !isIndexableSong(initialData);
---

<Layout
  {title}
  {description}
  {song_url}
  {video_url}
  video_width={video_url ? 1024 : null}
  video_height={video_url ? 1024 : null}
  {twitter_player_url}
  twitter_player_width={twitter_player_url ? 480 : null}
  twitter_player_height={twitter_player_url ? 480 : null}
  {image_url}
  image_width={image_url ? 1024 : null}
  image_height={image_url ? 1024 : null}
  image_type={image_url ? 'image/png' : null}
  image_alt={image_url ? `${title} cover art` : null}
  {oembed_url}
  {noindex}
  nofollow={noindex}
>
  {isNotFound ? (
    <div class="app-container py-16">
      <StateFeedback
        kind="error"
        title="Song not found"
        message="This song could not be found."
        actionLabel="Browse songs"
        actionHref="/"
      />
    </div>
  ) : (
    <Smol {id} {initialData} client:only="svelte" />
  )}
</Layout>
