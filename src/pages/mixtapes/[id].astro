---
import MixtapeDetailView from '../../components/mixtape/MixtapeDetailView.svelte';
import Layout from '../../layouts/Layout.astro';
import { parseMixtapeNotFound, toMixtapeDetail, type ApiMixtapeDetail } from '../../services/api/mixtapes';
import { serverApiFetchResult } from '../../services/api/server';

const { id } = Astro.params;
const result = id
  ? await serverApiFetchResult<ApiMixtapeDetail>(Astro, `/mixtapes/${encodeURIComponent(id)}`)
  : { status: 404, data: null };

if (result.status === 404) {
  // A merged mixtape keeps its link: send it to the mixtape that now holds its songs.
  const notFound = parseMixtapeNotFound(result.data);
  if (notFound.kind === 'merged' && notFound.mergedInto !== id) {
    return Astro.redirect(`/mixtapes/${encodeURIComponent(notFound.mergedInto)}?merged=1`, 307);
  }
}

const initialData = result.status === 200 && result.data && Array.isArray(result.data.Smols) ? toMixtapeDetail(result.data) : null;
// Missing and deleted mixtapes are a real 404. An unreachable API (status 0 / 5xx) lets the island retry.
const initialNotFound = Boolean(!id || result.status === 404);
if (initialNotFound) {
  Astro.response.status = 404;
}
// Hidden ("owner") mixtapes stay playable by link but are never indexed.
const noindex = initialData?.visibility === 'owner';
const title = initialData ? initialData.title : 'Mixtape not found';
const description = initialData?.description || 'Smol art onchain';
const image_url = initialData?.coverUrls[0] ?? null;
---

<Layout {title} {description} {image_url} {noindex}>
  <MixtapeDetailView id={id ?? ''} {initialData} {initialNotFound} client:only="svelte" />
</Layout>
