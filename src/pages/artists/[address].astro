---
import ArtistPage from '../../components/ArtistPage.svelte';
import Layout from '../../layouts/Layout.astro';
import { serverApiFetch } from '../../services/api/ssr';
import type { ArtistSmolsResponse } from '../../types/api';
import { shortenAddress } from '../../utils/address';

const { address } = Astro.params;
const initialData = address
  ? await serverApiFetch<ArtistSmolsResponse>(Astro, `/artists/${encodeURIComponent(address)}/smols?limit=100`)
  : null;
const displayName = initialData?.artist?.Username || shortenAddress(address);
const title = displayName || 'Artist';
const description = `Public songs by ${displayName || 'artist'}`;
---

<Layout {title} {description}>
  <ArtistPage address={address ?? ''} {initialData} client:only="svelte" />
</Layout>
