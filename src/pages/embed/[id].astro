---
/**
 * Minimal, frameable audio player for oEmbed iframes and future player cards.
 * Zero Svelte/Web3/ClientRouter JS so it boots immediately inside sandboxed social iframes.
 */
import { serverApiFetchResult } from '../../services/api/ssr';
import type { SmolDetailResponse } from '../../types/domain';
import { songSafety } from '../../utils/songSafety';

const { id } = Astro.params;
const isSongId = Boolean(id && /^[0-9a-f]{64}$/i.test(id));
const result = isSongId
  ? await serverApiFetchResult<SmolDetailResponse>(Astro, `/${encodeURIComponent(id!)}?no_view=1`)
  : { status: 404, data: null };

const isOutage = isSongId && (result.status === 0 || result.status >= 500);
const data = result.status === 200 ? result.data : null;
const isRestricted = songSafety(data?.kv_do?.nsfw).restricted;
const firstReady = data?.kv_do?.songs?.[0];
const musicId =
  data?.d1?.Song_1 || (firstReady && firstReady.status >= 4 && firstReady.music_id ? firstReady.music_id : null);
const playable = Boolean(id && data?.d1 && !isRestricted && musicId);

const apiUrl = import.meta.env.PUBLIC_API_URL.replace(/\/+$/, '');
let apiOrigin = apiUrl;
try {
  apiOrigin = new URL(apiUrl).origin;
} catch {
  // Keep raw value if non-URL in test
}

if (isOutage) {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
} else if (!playable) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', 'public, max-age=300');
}

// Allow framing on oEmbed consumers/X while locking down all other resource origins.
Astro.response.headers.set(
  'Content-Security-Policy',
  `default-src 'none'; img-src ${apiOrigin} 'self'; media-src ${apiOrigin}; connect-src ${apiOrigin}; style-src 'unsafe-inline'; script-src 'unsafe-inline'; frame-ancestors *`
);
Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');

// Never leak titles of restricted or missing songs into <title>.
const title = playable ? data!.kv_do?.lyrics?.title || data!.d1!.Title || 'SMOL Song' : 'SMOL';
const artist = playable ? data!.d1!.Username || data!.d1!.Creator || data!.d1!.artist || data!.d1!.author || null : null;
const imageUrl = playable ? `${apiUrl}/image/${id}.png?scale=16` : null;
const audioUrl = playable ? `${apiUrl}/song/${encodeURIComponent(musicId!)}.mp3` : null;
const songHref = id && isSongId ? `${Astro.url.origin}/${id}` : Astro.url.origin;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={songHref} />
    <title>{playable ? `${title} · SMOL` : 'SMOL'}</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #0a0a0c;
        color: #f4f4f6;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .stage {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0a0a0c;
      }
      .cover {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        image-rendering: pixelated;
        image-rendering: crisp-edges;
      }
      .scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to bottom,
          rgba(10, 10, 12, 0.45) 0%,
          rgba(10, 10, 12, 0.08) 38%,
          rgba(10, 10, 12, 0.72) 72%,
          rgba(10, 10, 12, 0.94) 100%
        );
      }
      .top {
        position: absolute;
        top: 12px;
        left: 12px;
        right: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        z-index: 2;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 999px;
        background: rgba(10, 10, 12, 0.72);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: #9ae600;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-decoration: none;
        backdrop-filter: blur(8px);
      }
      .badge:hover { background: rgba(10, 10, 12, 0.9); }
      .controls {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 14px 16px 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        z-index: 2;
      }
      .meta {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
      }
      .play-btn {
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        border-radius: 999px;
        border: none;
        background: #9ae600;
        color: #09090b;
        display: grid;
        place-items: center;
        cursor: pointer;
        transition: transform 0.12s ease, background 0.12s ease;
      }
      .play-btn:hover { background: #b1f525; }
      .play-btn:active { transform: scale(0.95); }
      .play-btn:focus-visible, .scrub:focus-visible, .badge:focus-visible {
        outline: 2px solid #9ae600;
        outline-offset: 2px;
      }
      .titles { min-width: 0; flex: 1; }
      .title {
        font-size: 16px;
        font-weight: 700;
        line-height: 1.25;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .artist {
        font-size: 12px;
        color: rgba(244, 244, 246, 0.75);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-top: 2px;
      }
      .bar-row {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .time {
        font-variant-numeric: tabular-nums;
        font-size: 11px;
        color: rgba(244, 244, 246, 0.8);
        min-width: 32px;
      }
      .time.end { text-align: right; }
      .scrub {
        flex: 1;
        height: 6px;
        accent-color: #9ae600;
        cursor: pointer;
      }
      .native-audio { width: 100%; height: 36px; }
      .js-only { display: none; }
      .js-ready .js-only { display: flex; }
      .js-ready .native-audio { display: none; }
      .err-msg {
        display: none;
        font-size: 12px;
        color: #fca5a5;
      }
      .err-msg a { color: #9ae600; text-decoration: underline; }
      .empty {
        text-align: center;
        padding: 24px;
        color: rgba(244, 244, 246, 0.75);
        font-size: 14px;
      }
      .empty a { color: #9ae600; text-decoration: none; font-weight: 600; }
      @media (max-width: 300px) {
        .top { top: 8px; left: 8px; right: 8px; }
        .controls { padding: 10px 10px 12px; gap: 6px; }
        .play-btn { width: 40px; height: 40px; }
        .title { font-size: 14px; }
      }
    </style>
  </head>
  <body>
    {playable ? (
      <div id="stage" class="stage">
        <img class="cover" src={imageUrl!} alt={`${title} cover art`} width="1024" height="1024" />
        <div class="scrim"></div>
        <div class="top">
          <a class="badge" href={songHref} target="_blank" rel="noopener noreferrer">SMOL ↗</a>
        </div>
        <div class="controls">
          <div class="meta">
            <button id="toggle" class="play-btn js-only" type="button" aria-label={`Play ${title}`}>
              <svg id="icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11-6.86a1 1 0 0 0 0-1.7l-11-6.86A1 1 0 0 0 8 5.14z" />
              </svg>
              <svg id="icon-pause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:none">
                <rect x="6" y="4" width="4" height="16" rx="1" />
                <rect x="14" y="4" width="4" height="16" rx="1" />
              </svg>
            </button>
            <div class="titles">
              <div class="title">{title}</div>
              {artist && <div class="artist">{artist}</div>}
            </div>
          </div>
          <audio id="audio" class="native-audio" controls preload="none" playsinline src={audioUrl!}></audio>
          <div class="bar-row js-only">
            <span id="cur" class="time">0:00</span>
            <input id="scrub" class="scrub" type="range" min="0" max="1000" value="0" aria-label="Seek audio" />
            <span id="dur" class="time end">--:--</span>
          </div>
          <p id="err" class="err-msg">
            Playback unavailable here. <a href={songHref} target="_blank" rel="noopener noreferrer">Open on SMOL ↗</a>
          </p>
        </div>
        <script is:inline define:vars={{ apiUrl, musicId, title }}>
          (() => {
            const stage = document.getElementById('stage');
            const audio = document.getElementById('audio');
            const toggle = document.getElementById('toggle');
            const iconPlay = document.getElementById('icon-play');
            const iconPause = document.getElementById('icon-pause');
            const scrub = document.getElementById('scrub');
            const cur = document.getElementById('cur');
            const dur = document.getElementById('dur');
            const errEl = document.getElementById('err');
            if (!stage || !audio || !toggle || !scrub || !cur || !dur) return;

            stage.classList.add('js-ready');

            let seeking = false;
            let beaconSent = false;
            let elapsedMs = 0;
            let activeSince = null;

            const fmt = (sec) => {
              if (!Number.isFinite(sec) || sec < 0) return '--:--';
              const s = Math.floor(sec);
              return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
            };

            const pauseElapsed = () => {
              if (activeSince !== null) {
                elapsedMs += Date.now() - activeSince;
                activeSince = null;
              }
            };

            const maybeSendBeacon = () => {
              if (beaconSent) return;
              const total = elapsedMs + (activeSince !== null ? Date.now() - activeSince : 0);
              if (total >= 4000) {
                beaconSent = true;
                fetch(`${apiUrl}/plays/${encodeURIComponent(musicId)}`, {
                  method: 'POST',
                  keepalive: true,
                }).catch(() => {});
              }
            };

            const syncButton = () => {
              const playing = !audio.paused && !audio.ended;
              iconPlay.style.display = playing ? 'none' : '';
              iconPause.style.display = playing ? '' : 'none';
              toggle.setAttribute('aria-label', `${playing ? 'Pause' : 'Play'} ${title}`);
            };

            const showError = () => {
              if (errEl) errEl.style.display = 'block';
            };

            const togglePlay = () => {
              if (errEl) errEl.style.display = 'none';
              if (audio.paused || audio.ended) {
                audio.play().catch(showError);
              } else {
                audio.pause();
              }
            };

            toggle.addEventListener('click', (ev) => {
              ev.stopPropagation();
              togglePlay();
            });

            stage.addEventListener('click', (ev) => {
              if (ev.target && ev.target.closest('a, button, input, audio')) return;
              togglePlay();
            });

            // X appends ?autoplay=1&auto_play=true when the user clicks Play on the Player Card.
            const params = new URLSearchParams(window.location.search);
            if (params.get('autoplay') === '1' || params.get('auto_play') === 'true') {
              audio.play().catch(() => {
                // Browser blocked unmuted autoplay before an inside-frame gesture; keep Play ready.
              });
            }

            audio.addEventListener('loadedmetadata', () => {
              dur.textContent = fmt(audio.duration);
            });
            audio.addEventListener('playing', () => {
              if (activeSince === null) activeSince = Date.now();
              syncButton();
            });
            audio.addEventListener('waiting', pauseElapsed);
            audio.addEventListener('pause', () => {
              pauseElapsed();
              syncButton();
            });
            audio.addEventListener('ended', () => {
              pauseElapsed();
              maybeSendBeacon();
              syncButton();
            });
            audio.addEventListener('error', () => {
              pauseElapsed();
              syncButton();
              showError();
            });

            audio.addEventListener('timeupdate', () => {
              cur.textContent = fmt(audio.currentTime);
              if (Number.isFinite(audio.duration) && audio.duration > 0 && !seeking) {
                scrub.value = String(Math.round((audio.currentTime / audio.duration) * 1000));
              }
              maybeSendBeacon();
            });

            scrub.addEventListener('input', () => {
              seeking = true;
              if (Number.isFinite(audio.duration) && audio.duration > 0) {
                cur.textContent = fmt((Number(scrub.value) / 1000) * audio.duration);
              }
            });
            scrub.addEventListener('change', () => {
              if (Number.isFinite(audio.duration) && audio.duration > 0) {
                audio.currentTime = (Number(scrub.value) / 1000) * audio.duration;
              }
              seeking = false;
            });
          })();
        </script>
      </div>
    ) : (
      <div class="stage">
        <div class="empty">
          <p>{isOutage ? 'Temporarily unavailable.' : 'This song cannot be embedded.'}</p>
          <p style="margin-top:8px"><a href={songHref} target="_blank" rel="noopener noreferrer">Open SMOL ↗</a></p>
        </div>
      </div>
    )}
  </body>
</html>
