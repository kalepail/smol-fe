---
import { ClientRouter } from 'astro:transitions';
import TopBar from '../components/shell/TopBar.svelte';
import TabBar from '../components/shell/TabBar.svelte';
import MixtapeBuilderOverlay from '../components/mixtape/MixtapeBuilderOverlay.svelte';
import PlayerDock from '../components/player/PlayerDock.svelte';
import {
	readSessionCookieFromRequest,
	resolveSessionCookieRead,
} from '../utils/sessionToken';
import { robotsContent } from '../utils/robots';
import '../styles/global.css';

interface Props {
	title?: string;
	/** Pass `null` to omit description meta tags. */
	description?: string | null;
	song_url?: string | null;
	video_url?: string | null;
	video_width?: number | null;
	video_height?: number | null;
	twitter_player_url?: string | null;
	twitter_player_width?: number | null;
	twitter_player_height?: number | null;
	image_url?: string | null;
	image_width?: number | null;
	image_height?: number | null;
	image_type?: string | null;
	image_alt?: string | null;
	oembed_url?: string | null;
	/** Keep this page out of search indexes (e.g. a mixtape hidden from the Mixtapes page). */
	noindex?: boolean;
	/** With `noindex`: also don't follow links (private / restricted songs). */
	nofollow?: boolean;
}

const {
	title,
	description = 'Smol art onchain',
	song_url = null,
	video_url = null,
	video_width = null,
	video_height = null,
	twitter_player_url = null,
	twitter_player_width = null,
	twitter_player_height = null,
	image_url,
	image_width = null,
	image_height = null,
	image_type = null,
	image_alt = null,
	oembed_url = null,
	noindex = false,
	nofollow = false,
} = Astro.props;

const resolvedImageUrl = image_url ? `${image_url}?scale=16` : 'https://smol.xyz/meta.png';
const ogType = video_url ? 'video.other' : song_url ? 'music.song' : 'website';

// E2E only (compiled out unless PUBLIC_E2E_SEAMS=1): the dev server can't be
// reached as smol.xyz, so Playwright names the production host in a header to
// exercise the indexable branch.
const robotsHost =
	(import.meta.env.PUBLIC_E2E_SEAMS === '1' && Astro.request.headers.get('x-smol-e2e-host')) || Astro.url.hostname;
const robots = robotsContent({ hostname: robotsHost, noindex, nofollow });

const pageTitle = title ? (title.includes('SMOL') ? title : `${title} · SMOL`) : 'SMOL';
// Keep og:title free of site suffix since og:site_name is set (Apple TN3156 + Discord).
const ogTitle = title || 'SMOL';

// Prevent clickjacking on wallet/app pages; only /embed/[id] opts into cross-origin framing.
Astro.response.headers.set('Content-Security-Policy', "frame-ancestors 'self'");

const cookieRead = readSessionCookieFromRequest(Astro);
if (cookieRead.present) {
	Astro.response.headers.set('Cache-Control', 'private, no-store');
}

const session = resolveSessionCookieRead(cookieRead, Astro.url.hostname);
const _kid: string | null = session.kid;
const _cid: string | null = session.cid;

if (session.shouldDeleteCookie) {
	Astro.cookies.delete('smol_token', session.deleteCookieOptions);
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content={robots} />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="apple-touch-icon" href={image_url ? image_url : 'https://smol.xyz/favicon.png'} />
		<link rel="icon" type="image/png" href={image_url ? image_url : 'https://smol.xyz/favicon.png'} />
		<meta name="generator" content={Astro.generator} />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content={pageTitle} />
		<meta name="theme-color" content="#9ae600" />
		<link rel="manifest" href="/manifest.json" />
		<ClientRouter />

		<title transition:animate="fade">{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={Astro.url} />

		{/* Emit twitter:card before og:type so Discord's "last layout tag wins" rule picks og:type=video.other while X keeps player (Twitterbot) or summary_large_image. */}
		<meta name="twitter:card" content={twitter_player_url ? 'player' : 'summary_large_image'} />
		<meta name="twitter:title" content={ogTitle} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={resolvedImageUrl} />
		{image_url && image_alt && <meta name="twitter:image:alt" content={image_alt} />}
		<meta name="twitter:url" content={Astro.url} />
		{twitter_player_url && <meta name="twitter:player" content={twitter_player_url} />}
		{twitter_player_url && <meta name="twitter:player:width" content={String(twitter_player_width ?? 480)} />}
		{twitter_player_url && <meta name="twitter:player:height" content={String(twitter_player_height ?? 480)} />}

		<meta property="og:site_name" content="SMOL" />
		<meta property="og:title" content={ogTitle} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={resolvedImageUrl} />
		{image_url && image_type && <meta property="og:image:type" content={image_type} />}
		{image_url && image_width && <meta property="og:image:width" content={String(image_width)} />}
		{image_url && image_height && <meta property="og:image:height" content={String(image_height)} />}
		{image_url && image_alt && <meta property="og:image:alt" content={image_alt} />}
		{video_url && <meta property="og:video" content={video_url} />}
		{video_url && <meta property="og:video:secure_url" content={video_url} />}
		{video_url && <meta property="og:video:type" content="video/mp4" />}
		{video_url && video_width && <meta property="og:video:width" content={String(video_width)} />}
		{video_url && video_height && <meta property="og:video:height" content={String(video_height)} />}
		{song_url && <meta property="og:audio" content={song_url} />}
		{song_url && <meta property="og:audio:secure_url" content={song_url} />}
		{song_url && <meta property="og:audio:type" content="audio/mpeg" />}
		{oembed_url && <link rel="alternate" type="application/json+oembed" href={oembed_url} title={ogTitle} />}
	</head>
	<body class="bg-canvas text-ink-1 antialiased">
		<TopBar {_kid} {_cid} client:only="svelte" transition:persist="header" />
		<main id="main">
			<slot />
		</main>
		<PlayerDock client:only="svelte" transition:persist="audio-player" />
		<TabBar client:only="svelte" transition:persist="tab-bar" />
		<MixtapeBuilderOverlay client:only="svelte" transition:persist="mixtape-overlay" />
	</body>
</html>
