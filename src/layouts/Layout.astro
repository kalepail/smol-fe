---
import { ClientRouter } from 'astro:transitions';
import TopBar from '../components/shell/TopBar.svelte';
import TabBar from '../components/shell/TabBar.svelte';
import MixtapeBuilderOverlay from '../components/mixtape/MixtapeBuilderOverlay.svelte';
import PlayerDock from '../components/player/PlayerDock.svelte';
import {
	readSessionCookieFromRequest,
	resolveSessionCookieRead,
} from '../utils/sessionToken';
import { robotsContent } from '../utils/robots';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	song_url?: string | null;
	image_url?: string | null;
	/** Keep this page out of search indexes (e.g. a mixtape hidden from the Mixtapes page). */
	noindex?: boolean;
	/** With `noindex`: also don't follow links (private / restricted songs). */
	nofollow?: boolean;
}

const {
	title,
	description = 'Smol art onchain',
	song_url = null,
	image_url,
	noindex = false,
	nofollow = false,
} = Astro.props;

// E2E only (compiled out unless PUBLIC_E2E_SEAMS=1): the dev server can't be
// reached as smol.xyz, so Playwright names the production host in a header to
// exercise the indexable branch.
const robotsHost =
	(import.meta.env.PUBLIC_E2E_SEAMS === '1' && Astro.request.headers.get('x-smol-e2e-host')) || Astro.url.hostname;
const robots = robotsContent({ hostname: robotsHost, noindex, nofollow });

const pageTitle = title ? (title.includes('SMOL') ? title : `${title} · SMOL`) : 'SMOL';

const cookieRead = readSessionCookieFromRequest(Astro);
if (cookieRead.present) {
	Astro.response.headers.set('Cache-Control', 'private, no-store');
}

const session = resolveSessionCookieRead(cookieRead, Astro.url.hostname);
const _kid: string | null = session.kid;
const _cid: string | null = session.cid;

if (session.shouldDeleteCookie) {
	Astro.cookies.delete('smol_token', session.deleteCookieOptions);
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content={robots} />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="apple-touch-icon" href={image_url ? image_url : 'https://smol.xyz/favicon.png'} />
		<link rel="icon" type="image/png" href={image_url ? image_url : 'https://smol.xyz/favicon.png'} />
		<meta name="generator" content={Astro.generator} />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content={pageTitle} />
		<meta name="theme-color" content="#9ae600" />
		<link rel="manifest" href="/manifest.json" />
		<ClientRouter />

		<title transition:animate="fade">{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={Astro.url} />

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={song_url ? 'music.song' : 'website'} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:image" content={image_url ? `${image_url}?scale=16` : 'https://smol.xyz/meta.png'} />
		{song_url && <meta property="og:audio" content={song_url} />}
		{song_url && <meta property="og:audio:type" content="audio/mpeg" />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image_url ? `${image_url}?scale=16` : 'https://smol.xyz/meta.png'} />
		<meta name="twitter:url" content={Astro.url} />
	</head>
	<body class="bg-canvas text-ink-1 antialiased">
		<TopBar {_kid} {_cid} client:only="svelte" transition:persist="header" />
		<main id="main">
			<slot />
		</main>
		<PlayerDock client:only="svelte" transition:persist="audio-player" />
		<TabBar client:only="svelte" transition:persist="tab-bar" />
		<MixtapeBuilderOverlay client:only="svelte" transition:persist="mixtape-overlay" />
	</body>
</html>
